    "source": "official_documentation",
    "url": "https://python.langchain.com/",
    "path": "langchain/official_documentation.json",
    "chunk_index": 2,
    "text": "This example demonstrates how to create a simple LangChain agent with a custom tool:\nOpenAI\nGoogle Gemini\nClaude (Anthropic)\nOpenRouter\nFireworks\nBaseten\nOllama\nAzure\nAWS Bedrock\nHuggingFace\n# pip install -qU langchain \"langchain[openai]\"from langchain.agents import create_agentdef get_weather(city: str) -> str: \"\"\"Get weather for a given city.\"\"\" return f\"It's always sunny in {city}!\"agent = create_agent( model=\"openai:gpt-5.5\", tools=[get_weather], system_prompt=\"You are a helpful assistant\",)result = agent.invoke( {\"messages\": [{\"role\": \"user\", \"content\": \"What's the weather in San Francisco?\"}]})print(result[\"messages\"][-1].content_blocks)",
    "character_count": 651
  },
