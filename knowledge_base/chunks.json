    "url": "https://github.com/facebookresearch/DPR",
    "path": "dense_retrieval/github_repository.json",
    "chunk_index": 20,
    "text": "out_file={path to the output file}\nAdjust batch_size based on the available number of GPUs, 64-128 should work for 2 GPU server.\nWe trained reader model for large datasets using a single 8 GPU x 32 GB server. All the default parameters are already set to our best NQ settings. Please also download data.gold_passages_info.nq_train & data.gold_passages_info.nq_dev resources for NQ datatset - they are used for special NQ only heuristics when preprocessing the data for the NQ reader training. If you already run reader trianign on NQ data without gold_passages_src & gold_passages_src_dev specified, please delete the corresponding .pkl files so that thye will be re-generated.\npython train_extractive_reader.py \\\nencoder.sequence_length=350 \\\ntrain_files={path to the retriever train set results file} \\\ndev_files={path to the retriever dev set results file} \\\ngold_passages_src={path to data.gold_passages_info.nq_train file} \\\ngold_passages_src_dev={path to data.gold_passages_info.nq_dev file} \\",
    "character_count": 999
  },
  {
    "chunk_id": "92b4b6f0-f597-4a5b-9361-58fefef09dcb",
    "technology": "Dense Retrieval",
    "technology_id": "source-dense-retrieval",
    "category": "retrieval",
    "organization": "Independent Research",
    "license": "CC-BY-NC 4.0",
