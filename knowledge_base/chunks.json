  {
    "chunk_id": "a017eec7-6d18-4af0-a324-8034a36b93ae",
    "technology": "FAISS",
    "technology_id": "source-faiss",
    "category": "vectordbs",
    "organization": "Meta AI",
    "license": "MIT",
    "priority": "high",
