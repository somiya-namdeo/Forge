    "character_count": 633
  },
  {
    "chunk_id": "da9e4930-2fb2-44f0-8f15-76e7d2b01d75",
    "technology": "FAISS",
    "technology_id": "source-faiss",
    "category": "vectordbs",
    "organization": "Meta AI",
    "license": "MIT",
    "priority": "high",
