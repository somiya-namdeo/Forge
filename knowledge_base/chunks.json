  {
    "chunk_id": "468d8c07-90a1-4e29-9850-d81ac1fee881",
    "technology": "Mistral",
    "technology_id": "source-mistral",
    "category": "llms",
    "organization": "Mistral AI",
    "license": "Apache 2.0",
    "priority": "high",
