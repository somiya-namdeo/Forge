  {
    "chunk_id": "a14272c4-be79-4ffc-a562-12ceae32f81f",
    "technology": "BAAI BGE Embeddings",
    "technology_id": "source-baai-bge",
    "category": "embeddings",
    "organization": "BAAI",
    "license": "MIT",
