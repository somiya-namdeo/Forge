  {
    "chunk_id": "7c2815a2-b696-40fc-92de-b58b31cb8f6a",
    "technology": "Arize Phoenix",
    "technology_id": "source-arize-phoenix",
    "category": "evaluation",
    "organization": "Arize AI",
    "license": "",
    "priority": "high",
