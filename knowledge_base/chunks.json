    "chunk_id": "82143132-4fc9-4472-86f5-067d8a1ccc2a",
    "technology": "QLoRA",
    "technology_id": "source-qlora",
    "category": "fine_tuning",
    "organization": "Independent Research",
    "license": "MIT",
    "priority": "high",
