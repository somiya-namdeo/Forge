  {
    "chunk_id": "44058ed7-ec2a-4f6c-b733-f4304bbf42e8",
    "technology": "KServe",
    "technology_id": "source-kserve",
    "category": "deployment",
    "organization": "Kubeflow",
    "license": "Apache-2.0",
