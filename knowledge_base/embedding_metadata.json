    "technology": "guidance",
    "source": "github_repository",
    "path": "guidance/github_repository.txt",
    "chunk_index": 8,
    "text": "@guidance(stateless=True)\ndef _gen_header(lm: Model):\nlm += \"<head>\\n\"\nlm += _gen_text_in_tag(\"title\") + \"\\n\"\nlm += \"</head>\\n\"\nreturn lmThe body of the HTML page is going to be filled with headings and paragraphs. We can define a function to do each:\nfrom guidance.library import one_or_more\n@guidance(stateless=True)\ndef _gen_heading(lm: Model):\nlm += select(\noptions=[_gen_text_in_tag(\"h1\"), _gen_text_in_tag(\"h2\"), _gen_text_in_tag(\"h3\")]\n)\nlm += \"\\n\"\nreturn lm\n@guidance(stateless=True)\ndef _gen_para(lm: Model):\nlm += \"<p>\"\nlm += one_or_more(\nselect(\noptions=[\n_gen_text(),\n_gen_text_in_tag(\"em\"),\n_gen_text_in_tag(\"strong\"),\n\"<br />\",\n],\n)\n)\nlm += \"</p>\\n\"\nreturn lmNow, the function to define the body of the HTML itself:\n@guidance(stateless=True)\ndef _gen_body(lm: Model):\nlm += \"<body>\\n\"\nlm += one_or_more(select(options=[_gen_heading(), one_or_more(_gen_para())]))\nlm += \"</body>\\n\"",
