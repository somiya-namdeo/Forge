    "chunk_index": 8,
    "text": "huggingface-cli download meta-llama/Llama-4-Scout-17B-16E-Instruct-Original --local-dir meta-llama/Llama-4-Scout-17B-16E-Instruct-Original-\nTo use with transformers, the following snippet will download and cache the weights: # inference.py from transformers import AutoTokenizer, Llama4ForConditionalGeneration import torch model_id = \"meta-llama/Llama-4-Scout-17B-16E-Instruct\" tokenizer = AutoTokenizer.from_pretrained(model_id) messages = [ {\"role\": \"user\", \"content\": \"Who are you?\"}, ] inputs = tokenizer.apply_chat_template( messages, add_generation_prompt=True, return_tensors=\"pt\", return_dict=True ) model = Llama4ForConditionalGeneration.from_pretrained( model_id, device_map=\"auto\", torch_dtype=torch.bfloat16 ) outputs = model.generate(**inputs.to(model.device), max_new_tokens=100) outputs = tokenizer.batch_decode(outputs[:, inputs[\"input_ids\"].shape[-1] :]) print(outputs[0]) torchrun --nnodes=1 --nproc_per_node=8 inference.py",
